# ---------------------------------------------------------------------------
# FamilyFlow environment
# Copy this file to .env.local. Zonder keys draait de app gewoon: Flow valt dan
# terug op de ingebouwde regelgebaseerde coach (deterministisch, geen netwerk).
# ---------------------------------------------------------------------------

# claude | openai | gemini | none
AI_PROVIDER=none

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gratis te verkrijgen via aistudio.google.com/apikey (rate-limited free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optioneel. Leeg laten = localStorage-opslag (development fallback).
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen nodig voor echte pushmeldingen (lib/push/cron.ts, api/cron/reminders).
# Service-role key: Supabase -> Project Settings -> API Keys -> Legacy -> service_role.
# Bypasst RLS, dus ALLEEN server-side gebruiken, nooit NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Genereer eenmalig met: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Willekeurige string, zelfde waarde als de GitHub Actions secret CRON_SECRET
# (.github/workflows/reminder-push.yml) — beveiligt api/cron/reminders.
CRON_SECRET=
